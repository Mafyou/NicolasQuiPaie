<Project Sdk="Microsoft.NET.Sdk">

  <!--
    User journeys, end to end and black box: the API and the Blazor front (served by NicolasQuiPaieWeb.Host) both run
    on real Kestrel ports, on a SQLite database of their own; the API is driven over HTTP, the front in Chromium
    (Playwright). Nothing leaves the machine but the CDN scripts of the page: the production API is never called.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both apps declare a global Program: each reference gets an alias of its own. -->
    <ProjectReference Include="..\..\Back\NicolasQuiPaieAPI\NicolasQuiPaieAPI.csproj" Aliases="Api" />
    <ProjectReference Include="..\..\Front\NicolasQuiPaieWeb.Host\NicolasQuiPaieWeb.Host.csproj" Aliases="WebHost" />
    <ProjectReference Include="..\..\Back\NicolasQuiPaieAPI.Infrastructure\NicolasQuiPaieAPI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\NicolasQuiPaieData\NicolasQuiPaieData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\NicolasQuiPaie.IntegrationTests\Fixtures\SqliteModelCustomizer.cs" Link="Support\SqliteModelCustomizer.cs" />
  </ItemGroup>

</Project>
