<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Serves the Blazor WebAssembly front (NicolasQuiPaieWeb) from an App Service: its files, then index.html for every client route. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NicolasQuiPaieWeb\NicolasQuiPaieWeb.csproj" />
  </ItemGroup>

  <!-- App Service starts the only *.runtimeconfig.json it finds; the Blazor project brings its own, which is not an app
       to run: without it, the platform falls back to its default page. -->
  <Target Name="RemoveFrontRuntimeConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)NicolasQuiPaieWeb.runtimeconfig.json" />
  </Target>

</Project>
